<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Widget.ADBSmart.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textAllCaps">false</item>
    </style>
    <style name="Theme.LADB" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="materialButtonStyle">@style/Widget.ADBSmart.Button</item>
        <item name="colorPrimary">#1769D2</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorSecondary">#21A99A</item>
        <item name="android:statusBarColor">#F5F8FD</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">#FFFFFF</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:fontFamily">sans</item>
        <item name="fontFamily">sans</item>
        <item name="android:windowBackground">#F5F8FD</item>
    </style>
</resources>